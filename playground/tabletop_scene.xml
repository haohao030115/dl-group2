<mujoco model="g1_tabletop">

    <!-- Official G1 + hand model -->
    <include file="../third_party/GR00T-WholeBodyControl/decoupled_wbc/control/robot_model/model_data/g1/g1_29dof_with_hand.xml"/>

    <!-- The included G1 XML uses meshdir="meshes".
         Since our main XML is outside that folder, point MuJoCo to the real mesh directory. -->
    <compiler
        angle="radian"
        meshdir="../third_party/GR00T-WholeBodyControl/decoupled_wbc/control/robot_model/model_data/g1/meshes"
    />

    <option timestep="0.002" gravity="0 0 -9.81"/>

    <statistic center="0.4 0 0.8" extent="2.0"/>

    <visual>
        <headlight
            diffuse="0.6 0.6 0.6"
            ambient="0.3 0.3 0.3"
            specular="0 0 0"
        />
        <global azimuth="-130" elevation="-20"/>
    </visual>

    <asset>
        <texture
            type="2d"
            name="groundplane"
            builtin="checker"
            rgb1="0.25 0.25 0.25"
            rgb2="0.15 0.15 0.15"
            width="300"
            height="300"
        />

        <material
            name="groundplane"
            texture="groundplane"
            texuniform="true"
            texrepeat="5 5"
            reflectance="0.2"
        />

        <material
            name="table_material"
            rgba="0.65 0.45 0.22 1"
        />

        <material
            name="block_material"
            rgba="0.9 0.1 0.1 1"
        />
    </asset>

    <worldbody>

        <!-- Light -->
        <light
            pos="0 0 2.5"
            dir="0 0 -1"
            directional="true"
        />

        <!-- Ground: z = 0 -->
        <geom
            name="floor"
            type="plane"
            size="3 3 0.05"
            material="groundplane"
            friction="1 0.005 0.0001"
        />

        <!-- ========================= -->
        <!-- Table                     -->
        <!-- ========================= -->

        <!--
            Table dimensions:
            top surface height = 0.75 m
            tabletop thickness = 0.05 m

            MuJoCo box "size" is HALF-size.
            Therefore tabletop:
                center z = 0.725
                half-height = 0.025
                top = 0.750
                bottom = 0.700
        -->

        <body name="table">

            <!-- tabletop -->
            <geom
                name="table_top"
                type="box"
                pos="0.70 0 0.725"
                size="0.35 0.45 0.025"
                material="table_material"
                friction="1 0.005 0.0001"
            />

            <!-- front-left leg -->
            <geom
                name="table_leg_fl"
                type="box"
                pos="0.42 0.37 0.35"
                size="0.035 0.035 0.35"
                material="table_material"
            />

            <!-- front-right leg -->
            <geom
                name="table_leg_fr"
                type="box"
                pos="0.42 -0.37 0.35"
                size="0.035 0.035 0.35"
                material="table_material"
            />

            <!-- rear-left leg -->
            <geom
                name="table_leg_rl"
                type="box"
                pos="0.98 0.37 0.35"
                size="0.035 0.035 0.35"
                material="table_material"
            />

            <!-- rear-right leg -->
            <geom
                name="table_leg_rr"
                type="box"
                pos="0.98 -0.37 0.35"
                size="0.035 0.035 0.35"
                material="table_material"
            />

        </body>

        <!-- ========================= -->
        <!-- Graspable red block       -->
        <!-- ========================= -->

        <!--
            tabletop top = 0.750
            block half-height = 0.035

            therefore block center:
            z = 0.750 + 0.035 = 0.785
        -->

        <body
            name="block"
            pos="0.62 0 0.785"
        >

            <freejoint name="block_freejoint"/>

            <geom
                name="block_geom"
                type="box"
                size="0.035 0.035 0.035"
                mass="0.20"
                material="block_material"
                friction="1.2 0.01 0.001"
            />

        </body>

        <!-- Temporary camera; later we can attach one to G1 head -->
        <camera
            name="table_camera"
            pos="1.5 -1.5 1.4"
            xyaxes="0.70 0.70 0 -0.35 0.35 0.87"
            fovy="55"
        />

    </worldbody>

</mujoco>